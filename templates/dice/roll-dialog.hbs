<div class="ote-dialog">
  {{#if traits.length}}
  <div class="form-group">
    <label>{{localize "OTE.Dialog.Trait"}}</label>
    <div class="form-fields">
      <select name="trait">
        <option value="" data-dice="2">{{localize "OTE.Dialog.NoTrait"}}</option>
        {{#each traits}}<option value="{{id}}" data-dice="{{dice}}" {{#if selected}}selected{{/if}}>{{name}} ({{dice}}d)</option>{{/each}}
      </select>
    </div>
  </div>
  {{/if}}

  <div class="form-group">
    <label>{{localize "OTE.Dialog.Dice"}}</label>
    <div class="form-fields"><input type="number" name="dice" value="{{dice}}" min="0" step="1"></div>
  </div>
  <div class="form-group">
    <label>{{localize "OTE.Dialog.Bonus"}}</label>
    <div class="form-fields"><input type="number" name="bonus" value="0" min="0" step="1"></div>
  </div>
  <div class="form-group">
    <label>{{localize "OTE.Dialog.Penalty"}}</label>
    <div class="form-fields"><input type="number" name="penalty" value="{{penalty}}" min="0" step="1"></div>
    {{#if penaltyNotes}}<p class="hint">{{penaltyNotes}}</p>{{/if}}
  </div>
  <div class="form-group">
    <label>{{localize "OTE.Dialog.ExtraActions"}}</label>
    <div class="form-fields"><input type="number" name="extraActions" value="0" min="0" step="1"></div>
    <p class="hint">{{localize "OTE.Dialog.ExtraActionsHint"}}</p>
  </div>

  <div class="form-group">
    <label>{{localize "OTE.Dialog.Experience"}} ({{xpAvailable}})</label>
    <div class="form-fields">
      <input type="number" name="xpSpent" value="0" min="0" max="{{xpAllowed}}" step="1" {{#unless xpAllowed}}disabled{{/unless}}>
      <input type="text" name="xpReason" placeholder="{{localize 'OTE.Dialog.XPReason'}}" {{#unless xpAllowed}}disabled{{/unless}}>
    </div>
  </div>

  {{#if fringe}}
  <div class="form-group">
    <label>{{localize "OTE.Dialog.Push"}} ({{shotsAvailable}} {{localize "OTE.Shots"}})</label>
    <div class="form-fields"><input type="checkbox" name="push"></div>
    <p class="hint">{{localize "OTE.Dialog.PushHint"}}</p>
  </div>
  {{/if}}

  {{#if attack}}
  <fieldset class="ote-dialog-attack">
    <legend>{{localize "OTE.Dialog.Damage"}}</legend>
    <div class="form-group">
      <label>{{localize "OTE.Weapon.DamageFactor"}}</label>
      <div class="form-fields"><input type="number" name="factor" value="{{attack.factor}}" min="0" step="1"></div>
    </div>
    <div class="form-group">
      <label>{{localize "OTE.Weapon.AttackType"}}</label>
      <div class="form-fields"><select name="attackType">{{selectOptions attackTypes selected=attack.attackType localize=true}}</select></div>
    </div>
    <div class="form-group">
      <label>{{localize "OTE.Dialog.Special"}}</label>
      <div class="form-fields"><input type="checkbox" name="special"></div>
      <p class="hint">{{localize "OTE.Dialog.SpecialHint"}}</p>
    </div>
    <div class="form-group">
      <label>{{localize "OTE.Dialog.Divisor"}}</label>
      <div class="form-fields"><input type="number" name="divisor" value="1" min="1" step="1"></div>
      <p class="hint">{{localize "OTE.Dialog.DivisorHint"}}</p>
    </div>
  </fieldset>
  {{/if}}

  {{#if showDifficulty}}
  <div class="form-group">
    <label>{{localize "OTE.Dialog.Difficulty"}}</label>
    <div class="form-fields">
      <select name="difficultyMode">
        <option value="none">{{localize "OTE.Dialog.DiffNone"}}</option>
        <option value="fixed">{{localize "OTE.Dialog.DiffFixed"}}</option>
        <option value="dice">{{localize "OTE.Dialog.DiffDice"}}</option>
      </select>
      <input type="number" name="difficultyValue" value="7" min="0" step="1" disabled>
    </div>
    <p class="hint">{{localize "OTE.Dialog.DifficultyHint"}}</p>
  </div>
  <div class="form-group" data-ote-hide-opp hidden>
    <label>{{localize "OTE.Dialog.HideOpposition"}}</label>
    <div class="form-fields"><input type="checkbox" name="hideOpposition" checked></div>
  </div>
  {{/if}}

  <div class="form-group">
    <label>{{localize "OTE.Dialog.RollMode"}}</label>
    <div class="form-fields"><select name="rollMode">{{selectOptions rollModes selected=rollMode}}</select></div>
  </div>
</div>
